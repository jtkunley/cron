{
  "name": "cron",
  "version": "0.1.0",
  "description": "Lifecycle-managed cron jobs on top of node-cron with overlap protection, graceful stop, error hooks, and context wrapping.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "cron",
    "node-cron",
    "scheduler"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
