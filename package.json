{
    "name": "@jtkunley/cron",
    "version": "1.0.0",
    "description": "Scheduled jobs for Node.js services that skip overlapping runs, report failures without stopping the schedule, run each tick in its own context, and stop cleanly.",
    "keywords": [
        "cron",
        "scheduler",
        "node-cron",
        "graceful-shutdown",
        "asynclocalstorage",
        "node"
    ],
    "homepage": "https://github.com/jtkunley/cron#readme",
    "bugs": {
        "url": "https://github.com/jtkunley/cron/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jtkunley/cron.git"
    },
    "license": "MIT",
    "author": "jtkunley (https://github.com/jtkunley)",
    "type": "commonjs",
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
        "typecheck": "tsc",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:component": "vitest run --project component",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
        "prepublishOnly": "node -e \"console.error('Publish the built package: npm run build && npm publish dist'); process.exit(1)\""
    },
    "engines": {
        "node": ">=22"
    },
    "main": "./src/cron.js",
    "types": "./src/cron.d.ts",
    "exports": {
        ".": {
            "types": "./src/cron.d.ts",
            "default": "./src/cron.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "dependencies": {
        "node-cron": "^4.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    }
}
